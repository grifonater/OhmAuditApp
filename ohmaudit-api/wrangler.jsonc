{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ohmaudit-api",
  "account_id": "488131b4b757ad9a4541451b792e83e5",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-13",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "APP_ENV": "local",
    "APP_VERSION": "0.7.0",
    "SUPABASE_URL": "https://replace-me.supabase.co",
    "SUPABASE_JWT_AUDIENCE": "authenticated",
    "SUPABASE_PUBLISHABLE_KEY": "sb_publishable_ggas-APHHgjEHk15bEXFdg_tcVMHm7S",
    "WEB_APP_URL": "http://localhost:4200",
    "PUBLIC_WEB_ORIGIN": "http://localhost:4200",
    "ALLOWED_ORIGINS": "http://localhost:4200",
  },
  "observability": {
    "enabled": true,
    "logs": { "head_sampling_rate": 1 },
  },
  "send_email": [{ "name": "EMAIL" }],
  "r2_buckets": [
    {
      "binding": "MEDIA_BUCKET",
      "bucket_name": "ohmaudit-media",
    },
  ],
  "env": {
    "local": {
      "name": "ohmaudit-api-local",
      "send_email": [{ "name": "EMAIL" }],
    },
    "development": {
      "name": "ohmaudit-api-development",
      "send_email": [{ "name": "EMAIL" }],
    },
    "staging": {
      "name": "ohmaudit-api-staging",
      "send_email": [{ "name": "EMAIL" }],
    },
    "production": {
      "name": "ohmaudit-api-production",
      "vars": {
        "APP_ENV": "production",
        "APP_VERSION": "0.7.0",
        "SUPABASE_URL": "https://cgynntzcxptnvsqrttsz.supabase.co",
        "SUPABASE_JWT_AUDIENCE": "authenticated",
        "SUPABASE_PUBLISHABLE_KEY": "sb_publishable_ggas-APHHgjEHk15bEXFdg_tcVMHm7S",
        "WEB_APP_URL": "https://ohmaudit.com",
        "PUBLIC_WEB_ORIGIN": "https://ohmaudit.com",
        "ALLOWED_ORIGINS": "https://ohmaudit-web.ohmaudit.workers.dev,https://ohmaudit.com",
        "EMAIL_FROM_ADDRESS": "noreply@ohmaudit.com",
        "EMAIL_FROM_NAME": "Ohm Audit",
        "CLOUDFLARE_ZONE_ID": "17e3a3905cfc5cf133020189c47112d5",
      },
      "send_email": [{ "name": "EMAIL", "allowed_sender_addresses": ["noreply@ohmaudit.com"] }],
      "queues": {
        "consumers": [
          {
            "queue": "ohmaudit-email-events-production",
            "max_batch_size": 25,
            "max_batch_timeout": 5,
            "max_retries": 5,
          },
        ],
      },
      "hyperdrive": [
        {
          "binding": "HYPERDRIVE",
          "id": "1b9c83b57a96418f9dc6e40126a34372",
        },
      ],
      "r2_buckets": [
        {
          "binding": "MEDIA_BUCKET",
          "bucket_name": "ohmaudit-media-production",
        },
      ],
      "services": [
        {
          "binding": "PDF_WORKER",
          "service": "ohmaudit-worker-pdf-production",
        },
        {
          "binding": "AI_WORKER",
          "service": "ohmaudit-worker-ai-production",
        },
      ],
    },
  },
}
