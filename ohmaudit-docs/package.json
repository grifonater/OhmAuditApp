{
  "name": "@ohmaudit/docs",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "markdownlint-cli2 **/*.md",
    "build": "node tests/validate-docs.mjs",
    "test": "node tests/validate-docs.mjs",
    "lint": "markdownlint-cli2 **/*.md",
    "format": "prettier --write **/*.md",
    "format:check": "prettier --check **/*.md",
    "typecheck": "node --check tests/validate-docs.mjs",
    "deploy": "echo Documentation publishes through the selected docs host"
  },
  "devDependencies": {
    "markdownlint-cli2": "^0.18.0",
    "prettier": "^3.0.0"
  },
  "engines": { "node": ">=24" },
  "packageManager": "pnpm@11.19.0"
}

