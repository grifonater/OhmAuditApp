{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ohmaudit-worker-notifications",
  "account_id": "488131b4b757ad9a4541451b792e83e5",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-13",
  "compatibility_flags": ["nodejs_compat"],
  "vars": { "APP_ENV": "local", "APP_VERSION": "0.4.0", "NOTIFICATION_BATCH_SIZE": "25" },
